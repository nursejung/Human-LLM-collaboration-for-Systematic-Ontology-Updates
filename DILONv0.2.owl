############################
#   Annotation Properties
############################

# Annotation Property: rdfs:KOR (rdfs:KOR)

AnnotationPropertyRange(rdfs:KOR xsd:string)

# Annotation Property: rdfs:Korean (rdfs:Korean)

AnnotationPropertyRange(rdfs:Korean xsd:string)

# Annotation Property: rdfs:SCT_ID (rdfs:SCT_ID)

AnnotationPropertyRange(rdfs:SCT_ID xsd:string)

# Annotation Property: rdfs:SCT_Name (rdfs:SCT_Name)

AnnotationPropertyRange(rdfs:SCT_Name xsd:string)

# Annotation Property: owl:KDO_ID (owl:KDO_ID)

AnnotationPropertyRange(owl:KDO_ID xsd:string)


############################
#   Object Properties
############################

# Object Property: foo:hasConceptDomain (foo:hasConceptDomain)

ObjectPropertyDomain(foo:hasConceptDomain foo:Question)
ObjectPropertyRange(foo:hasConceptDomain <http://www.co-ode.org/ontologies/ont.owl#Dietary_behavior>)

# Object Property: foo:hasFoodExample (foo:hasFoodExample)

ObjectPropertyDomain(foo:hasFoodExample foo:Question)
ObjectPropertyRange(foo:hasFoodExample <http://www.co-ode.org/ontologies/ont.owl#Food_item>)

# Object Property: foo:hasMeasProperty (foo:hasMeasProperty)

ObjectPropertyDomain(foo:hasMeasProperty foo:Question)
ObjectPropertyRange(foo:hasMeasProperty foo:Measurement_property)

# Object Property: foo:hasMeasTimeUnit (foo:hasMeasTimeUnit)

ObjectPropertyDomain(foo:hasMeasTimeUnit foo:Question)
ObjectPropertyRange(foo:hasMeasTimeUnit foo:Temporal_unit)

# Object Property: foo:hasObsPeriod (foo:hasObsPeriod)

ObjectPropertyDomain(foo:hasObsPeriod foo:Question)
ObjectPropertyRange(foo:hasObsPeriod foo:Observation_period)

# Object Property: foo:hasRespUnit (foo:hasRespUnit)

ObjectPropertyDomain(foo:hasRespUnit foo:Question)
ObjectPropertyRange(foo:hasRespUnit <http://www.co-ode.org/ontologies/ont.owl#Applicability_unit>)
ObjectPropertyRange(foo:hasRespUnit foo:Quality_unit)
ObjectPropertyRange(foo:hasRespUnit <urn:absolute:vegetable#Quantity_unit>)


############################
#   Data Properties
############################

# Data Property: foo:hasNumPV (foo:hasNumPV)

DataPropertyDomain(foo:hasNumPV foo:Question)
DataPropertyRange(foo:hasNumPV xsd:integer)



